# ─────────────────────────────────────────────────────────────────────────────
# LaTeXTrans Backend – Environment Variable Reference
# Copy this file to .env and fill in your values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM API ──────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Task Queue ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_TRANSLATIONS=
MAX_USER_ACTIVE_TASKS=
GUEST_TASK_TTL_HOURS=

#smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

#concurrent
LLM_MAX_CONCURRENT_REQUESTS=
