# LLM
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.example.com/v1/chat/completions
LLM_MODEL=your-model
LLM_TIMEOUT=60
MODEL_CONTEXT_TOKENS=32000
PIPELINE_TIMEOUT_SECONDS=0
PROMPT_RESERVE_TOKENS=4096

# Local auth / MySQL
DATABASE_URL=mysql://root:password@host.docker.internal:3306/latextrans
# Optional dedicated host-side MySQL connection for backend/scripts/apply_mysql_migrations.py.
# When set, the migration script prefers MYSQL_* over DATABASE_URL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=latextrans
MYSQL_CONNECT_TIMEOUT=10
AUTH_PROVIDER_MODE=niutrans_local
AUTH_JWT_KEYS=v1:change-me-local-dev-secret
AUTH_JWT_ISSUER=latextrans-local
AUTH_JWT_AUDIENCE=latextrans-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
NIUTRANS_AUTH_URL=https://niutrans.com/niutrans-auth/auth/login
NIUTRANS_LOGIN_URL=https://niutrans.com/login?active=0
NIUTRANS_REGISTER_URL=https://niutrans.com/login?active=3
NIUTRANS_ACCOUNT_URL=https://niutrans.com/login?active=0
# Optional bootstrap list. For long-lived admin grants, use backend/scripts/grant_local_admin.py after first login.
LOCAL_ADMIN_EXTERNAL_USER_IDS=
# Legacy import-source toggle only; keep false for local runtime.
ENABLE_LEGACY_IMPORT_READONLY=false
MIGRATION_DRY_RUN=false

# Encryption
ENCRYPTION_KEY=change-me-in-production

# Runtime / Queue
LATEX_RUNTIME_MODE=host
MAX_CONCURRENT_TRANSLATIONS=3
MAX_USER_ACTIVE_TASKS=9
GUEST_TASK_TTL_HOURS=2
LLM_MAX_CONCURRENT_REQUESTS=10

# CORS (comma-separated, no wildcard *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://latextrans.online

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Community
COMMUNITY_DOWNLOAD_TOKEN_SECRET=
# Optional baseline feed seed path; uncomment and set when needed.
# COMMUNITY_BASELINE_SEED_PATH=backend/data/community_baseline_seed.json

# Community Agent provider overrides
COMMUNITY_AGENT_SEARCH_API_URL=
COMMUNITY_AGENT_SEARCH_API_KEY=
COMMUNITY_AGENT_REASONING_API_URL=
COMMUNITY_AGENT_REASONING_API_KEY=
COMMUNITY_AGENT_REASONING_MODEL=
COMMUNITY_AGENT_PROVIDER_TIMEOUT_MS=
COMMUNITY_AGENT_TAVILY_API_KEY=
COMMUNITY_AGENT_TAVILY_BASE_URL=https://api.tavily.com

# LaTeX runtime
LATEX_BIN_DIR=
LATEX_DOCKER_IMAGE=latextrans-backend:latest

# Advanced runtime
ENABLE_TASK_CONFIG_CAPTURE=true
MAX_CONCURRENT_COMPILATIONS=1
ASYNC_COMPILER_ENABLED=true
ASYNC_BLOCKING_WRAPPERS_ENABLED=true
DB_EXECUTION_MODE=per_call_client
ENABLE_COMPILE_FIRST_STRUCTURAL_FALLBACK=true
ENABLE_POST_COMPILE_TARGET_LANGUAGE_FALLBACK=true
STRUCTURAL_FALLBACK_RATIO_CAP=0.38
STRUCTURAL_FALLBACK_CAP_MODE=soft
