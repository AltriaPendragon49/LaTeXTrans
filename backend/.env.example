# LLM
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.example.com/v1/chat/completions
LLM_MODEL=your-model
LLM_TIMEOUT=60

# Supabase (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_backend_only

# Encryption
ENCRYPTION_KEY=change-me-in-production

# Runtime / Queue
LATEX_RUNTIME_MODE=host
MAX_CONCURRENT_TRANSLATIONS=3
MAX_USER_ACTIVE_TASKS=9
GUEST_TASK_TTL_HOURS=2
LLM_MAX_CONCURRENT_REQUESTS=30

# CORS (comma-separated, no wildcard *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://latextrans.online

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
